{
  "name": "cwis-preservation-dashboard",
  "version": "0.2.72",
  "private": true,
  "scripts": {
    "build": "run-s db:prisma:generate build:next",
    "build:next": "next build",
    "contracts:sync": "sh -c 'bash ../../scripts/dashboard/sync-contracts.sh'",
    "db:prisma:generate": "prisma generate --schema=./lib/prisma/schema.prisma",
    "db:prisma:pull": "prisma db pull --schema=./lib/prisma/schema.prisma --force",
    "db:prisma:studio": "prisma studio",
    "dev": "run-p storybook dev:next",
    "dev:next": "next dev --webpack",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "run-p lint:project lint:markdown",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:project": "eslint --max-warnings=0 --cache --cache-location .eslintcache --cache-strategy content",
    "predev": "npm run contracts:sync",
    "prestorybook": "npm run contracts:sync",
    "pretest:integration": "npm run contracts:sync",
    "pretest:storybook": "npm run contracts:sync",
    "pretest:unit": "npm run contracts:sync",
    "pretypecheck": "npm run contracts:sync",
    "postinstall": "npm run db:prisma:generate && patch-package",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet --output-dir ./storybook-static",
    "storybook:clean": "rm -rf storybook-static",
    "storybook:preview": "storybook preview -p 6006 --storybook-dir ./storybook-static",
    "test": "run-s test:unit test:integration",
    "test:unit": "vitest run --project unit tests/unit",
    "test:unit:watch": "vitest --project unit tests/unit",
    "test:coverage": "vitest run --project unit tests/unit --coverage",
    "test:integration": "vitest run --project integration tests/integration",
    "test:storybook": "vitest run --project storybook",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.1",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.8.0",
    "luxon": "^3.7.2",
    "mariadb": "^3.5.2",
    "material-react-table": "^3.2.1",
    "mermaid": "^11.15.0",
    "mysql2": "^3.14.1",
    "next": "^16.2.6",
    "next-auth": "5.0.0-beta.31",
    "playwright": "^1.59.1",
    "prisma": "^7.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.3.5",
    "markdownlint-cli2": "0.23.0",
    "next-router-mock": "^1.0.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.14",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "overrides": {
    "@hono/node-server": "2.0.2",
    "fast-uri": "3.1.2",
    "glob": "13.0.6",
    "hono": "4.12.29",
    "postcss": "^8.5.14",
    "uuid": "14.0.0"
  },
  "engines": {
    "node": "24"
  }
}
