############################
### Database Credentials ###
############################
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password


#################
### Storybook ###
#################
STORYBOOK_URL=https://your-storybook.vercel.app


####################
### Google OAuth ###
####################
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Auth bypass token for debugging (server-side only)
# AUTH_BYPASS_TOKEN=dev-bypass


################
### NextAuth ###
################
# Use `openssl rand -base64 32` to generate AUTH_SECRET
AUTH_SECRET=generate-a-32-char-random-string
AUTH_URL=http://localhost:3000


###############
### General ###
###############
# When a local pipeline app runs in Docker and the dashboard runs on the host:
# DASHBOARD_BASE_URL=http://host.docker.internal:3000
DASHBOARD_BASE_URL=http://localhost:3000


###########################
### Process Integration ###
###########################
### Data Ingester ###
DATA_INGESTER_BASE_URL=http://localhost:8000
# Use `openssl rand -base64 32` to generate the `dashboard -> data-ingester` trigger token
DATA_INGESTER_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `data-ingester -> dashboard` callback token
DATA_INGESTER_CALLBACK_TOKEN=generate-a-32-char-random-string

### Document Splitter ###
DOCUMENT_SPLITTER_BASE_URL=http://localhost:8001
# Use `openssl rand -base64 32` to generate the `dashboard -> document-splitter` trigger token
DOCUMENT_SPLITTER_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `document-splitter -> dashboard` callback token
DOCUMENT_SPLITTER_CALLBACK_TOKEN=generate-a-32-char-random-string

### Page Rotator ###
PAGE_ROTATOR_BASE_URL=http://localhost:8002
# Use `openssl rand -base64 32` to generate the `dashboard -> page-rotator` trigger token
PAGE_ROTATOR_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `page-rotator -> dashboard` callback token
PAGE_ROTATOR_CALLBACK_TOKEN=generate-a-32-char-random-string

### OCR Processor ###
OCR_PROCESSOR_BASE_URL=http://localhost:8003
# Use `openssl rand -base64 32` to generate the `dashboard -> ocr-processor` trigger token
OCR_PROCESSOR_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `ocr-processor -> dashboard` callback token
OCR_PROCESSOR_CALLBACK_TOKEN=generate-a-32-char-random-string

### Content Deduplication Service ###
CONTENT_DEDUP_BASE_URL=http://localhost:8004
# Use `openssl rand -base64 32` to generate the `dashboard -> content-dedup` trigger token
CONTENT_DEDUP_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `content-dedup -> dashboard` callback token
CONTENT_DEDUP_CALLBACK_TOKEN=generate-a-32-char-random-string

### Metadata Extractor ###
METADATA_EXTRACTOR_BASE_URL=http://localhost:8005
# Use `openssl rand -base64 32` to generate the `dashboard -> metadata-extractor` trigger token
METADATA_EXTRACTOR_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `metadata-extractor -> dashboard` callback token
METADATA_EXTRACTOR_CALLBACK_TOKEN=generate-a-32-char-random-string
METADATA_EXTRACTOR_OPENAI_API_KEY='use your OpenAI key'

### METADATA VALIDATOR ###
MD_VALIDATE_BASE_URL=http://localhost:8006
# Use `openssl rand -base64 32` to generate the `dashboard -> metadata-validator` trigger token
MD_VALIDATE_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `metadata-validator -> dashboard` callback token
MD_VALIDATE_CALLBACK_TOKEN=generate-a-32-char-random-string

### RIGHTS DETERMINATOR ###
RIGHTS_DETERMINATOR_BASE_URL=http://localhost:8007
# Use `openssl rand -base64 32` to generate the `dashboard -> rights-determinator` trigger token
RIGHTS_DETERMINE_TRIGGER_TOKEN=generate-a-32-char-random-string

RIGHTS_DETERMINE_OPENAI_API_KEY='use your OpenAi key'

### FEDORA INGESTER ###
FEDORA_INGESTER_BASE_URL=http://localhost:8008
# Use `openssl rand -base64 32` to generate the `dashboard -> fedora-ingester` trigger token
FEDORA_INGESTER_TRIGGER_TOKEN=generate-a-32-char-random-string
# Use `openssl rand -base64 32` to generate the `fedora-ingester -> dashboard` callback token
FEDORA_INGESTER_CALLBACK_TOKEN=generate-a-32-char-random-string

# Optional: limit the top-level ingest folder browser to specific Drive folder IDs
GOOGLE_INGEST_SOURCE_ROOT_FOLDER_IDS=["folder-id-1","folder-id-2"]

# Google Drive service account for the process page folder browser
# Use exactly one:
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service_account.json
# The JSON has priority over the file path. Escape newlines in the private key.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"..."}'
